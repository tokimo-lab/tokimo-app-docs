{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "react": ["node_modules/@tokimo/ui/node_modules/@types/react"],
      "react/jsx-runtime": [
        "node_modules/@tokimo/ui/node_modules/@types/react/jsx-runtime"
      ],
      "react-dom": ["node_modules/@tokimo/ui/node_modules/@types/react-dom"],
      "react-dom/client": [
        "node_modules/@tokimo/ui/node_modules/@types/react-dom/client"
      ],
      "lucide-react": ["node_modules/@tokimo/ui/node_modules/lucide-react"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src"]
}
